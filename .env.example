# Local is the safe default. Public mode has additional startup requirements.
APP_MODE=local
HOST=127.0.0.1
PORT=8000

# Where APP_MODE=local keeps its agreement families. This directory persists:
# nothing in it is deleted on a timer or on restart.
LIBRARY_ROOT=data/library

# Visitor isolation and quotas. SESSION_TTL_HOURS applies to APP_MODE=public-demo
# only -- local mode has no expiry.
SESSION_TTL_HOURS=6
MAX_FILES_PER_SESSION=12
MAX_SESSION_BYTES=52428800
SESSION_COOKIE_SECURE=false
TRUST_CLOUDFLARE_HEADERS=false

# LM Studio must stay server-side and loopback-bound.
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=google/gemma-4-26b-a4b-qat
LMSTUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
# Exact model IDs that receive Qwen's per-turn soft switch.
LMSTUDIO_NO_THINK_MODELS=qwen3.6-27b-mlx
LMSTUDIO_ALLOWED_MODELS=
LMSTUDIO_API_TOKEN=
LMSTUDIO_TIMEOUT_SECONDS=180
LMSTUDIO_AUTOMANAGE_MODELS=false
LMSTUDIO_BATCH_CLAUSES=1
LMSTUDIO_BATCH_CHARS=12000
LMSTUDIO_EMBED_BATCH=16
LMSTUDIO_MAX_CONCURRENT_JOBS=1

# Required before APP_MODE=public-demo will start.
PUBLIC_OPERATOR_NAME=
PRIVACY_CONTACT_EMAIL=
PUBLIC_BASE_URL=
